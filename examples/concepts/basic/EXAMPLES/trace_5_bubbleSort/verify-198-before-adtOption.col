        );
        loop_invariant (\forall int k;
            k \in {0 .. j} ==>
                ptrDeref(ptrAdd(get_int_pointer(arr.get), k)).Int <= ptrDeref(ptrAdd(get_int_pointer(arr.get), j)).Int
        );
        for (
            {

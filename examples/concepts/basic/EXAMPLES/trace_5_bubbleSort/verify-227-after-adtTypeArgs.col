adt Pointer {
    pure Block pointerBlock(Pointer p);
    pure int pointerOffset(Pointer p);
    pure Pointer pointerInv(ref r);
    pure int ptrAddress(Pointer p, int stride);
    axiom (\forall Pointer p;
        Pointer.pointerOffset(p) >= 0 && Pointer.pointerOffset(p) < Block.blockLength(Pointer.pointerBlock(p))
    );
    axiom (\forall ref r; ptrDeref(Pointer.pointerInv(r)) == r);
    axiom (\forall Pointer p; Pointer.pointerInv(ptrDeref(p)) == p);
    axiom (\forall Pointer p, int stride;
        stride > 0 ==>
            Pointer.ptrAddress(p, stride) ==
            Block.blockAddress(Pointer.pointerBlock(p)) + Pointer.pointerOffset(p) * stride
    );
    axiom (\forall Pointer p, int stride; stride > 0 ==> Pointer.ptrAddress(p, stride) > 0);
    axiom (\forall Pointer p1, Pointer p2, int stride;
        stride > 0 &&
        Pointer.ptrAddress(p1, stride) == Pointer.ptrAddress(p2, stride) &&
        Pointer.pointerBlock(p1) == Pointer.pointerBlock(p2) ==>
            p1 == p2
    );
    axiom ptrAddAxiom();
    axiom ptrAddAxiom2();
    axiom (\forall Pointer i, int i1; Pointer.ptrAddress(i, i1) <= 18446744073709551615);
}


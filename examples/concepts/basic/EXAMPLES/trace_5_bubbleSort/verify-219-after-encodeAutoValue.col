                ptrDeref(ptrAdd(get_int_pointer(optGet<Pointer_1_array_int>(arr)), k)).Int <=
                ptrDeref(ptrAdd(get_int_pointer(optGet<Pointer_1_array_int>(arr)), k + 1)).Int
        );
        loop_invariant (\forall int g, int h;
            0 <= g && g < n - i && n - i <= h && h < n ==>
                ptrDeref(ptrAdd(get_int_pointer(optGet<Pointer_1_array_int>(arr)), g)).Int <=
                ptrDeref(ptrAdd(get_int_pointer(optGet<Pointer_1_array_int>(arr)), h)).Int
        );
        loop_invariant (\forall int k;
            0 <= k && k < j ==>
                ptrDeref(ptrAdd(get_int_pointer(optGet<Pointer_1_array_int>(arr)), k)).Int <=
                ptrDeref(ptrAdd(get_int_pointer(optGet<Pointer_1_array_int>(arr)), j)).Int
        );
        for (
            {
                int flatten;
                flatten = 0;
                j = flatten;
                flatten;
            };
            j < n - 1 - i;
            {

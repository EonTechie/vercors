            ptrDeref(ptrAdd(get_int_pointer(optGet<Pointer_1_array_int>(arr)), h)).Int
    );
    for (
        {
            int flatten;
            flatten = 0;
            i = flatten;
            flatten;
        };
        i < n - 1;
        {
            int flatten;
            flatten = i;
            i = i + 1;
            flatten;
        }
    ) {
        int j;
        label LOOP1;
        
        ref excbeforeloop1;
        excbeforeloop1 = exc;
        loop_invariant exc == excbeforeloop1;
        loop_invariant !(arr == Option<Pointer_1_array_int>.`none`());
        loop_invariant 0 <= Pointer.pointerOffset(get_int_pointer(optGet<Pointer_1_array_int>(arr))) + length;
        loop_invariant Pointer.pointerOffset(get_int_pointer(optGet<Pointer_1_array_int>(arr))) + length <=
        Block.blockLength(Pointer.pointerBlock(get_int_pointer(optGet<Pointer_1_array_int>(arr))));
        loop_invariant (\forall* int i1;
            0 <= i1 && i1 < length ==>
                Perm(ptrDeref(ptrAdd(get_int_pointer(optGet<Pointer_1_array_int>(arr)), i1)).Int, write)
        );
        loop_invariant 0 <= j;
        loop_invariant j < n - 1 - i + 1;
        loop_invariant (\forall int k;

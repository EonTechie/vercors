            }
        ) {
            if (
                ptrDeref(ptrAdd(get_int_pointer(optGet<Pointer_1_array_int>(arr)), j + 1)).Int <
                ptrDeref(ptrAdd(get_int_pointer(optGet<Pointer_1_array_int>(arr)), j)).Int

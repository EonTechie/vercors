adt Pointer_1_array_int {
    pure int get_dim_0_int(Pointer_1_array_int array);
    pure NonNull<int> get_int_pointer(Pointer_1_array_int array);
    pure Pointer_1_array_int from_int_pointer(NonNull<int> ptr);
    axiom (\forall NonNull<int> i; get_int_pointer({: from_int_pointer(i) :}) == i);
    axiom (\forall Pointer_1_array_int i;
        {:1: \pointer_block_length(get_int_pointer(i)) :} - {:2: \pointer_block_offset(get_int_pointer(i)) :} ==
        get_dim_0_int(i)
    );
    axiom (\forall Pointer_1_array_int i; {: get_dim_0_int(i) :} > 0);
}


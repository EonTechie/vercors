void bubbleSort(int tid, option<Pointer_1_array_int> arr, int length) {
    int n;
    n = length;
    int i;
    loop_invariant !arr.isEmpty;
    loop_invariant !arr.isEmpty;
    loop_invariant 0 <= \pointer_block_offset(arr.isEmpty ? null : get_int_pointer(arr.get)) + length;
    loop_invariant \pointer_block_offset(arr.isEmpty ? null : get_int_pointer(arr.get)) + length <=
    \pointer_block_length(arr.isEmpty ? null : get_int_pointer(arr.get));
    loop_invariant (\forall* int i1;
        0 <= i1 && i1 < length ==> Perm((arr.isEmpty ? null : get_int_pointer(arr.get)) + i1, write)
    );
    loop_invariant 0 <= i;
    loop_invariant i <= n;
    loop_invariant (\forall int k;
        n - i <= k && k < n - 1 ==> *(get_int_pointer(arr.get) + k + 0) <= *(get_int_pointer(arr.get) + k + 1 + 0)
    );
    loop_invariant (\forall int g, int h;
        0 <= g && g < n - i && n - i <= h && h < n ==>
            *(get_int_pointer(arr.get) + g + 0) <= *(get_int_pointer(arr.get) + h + 0)
    );
    for (i = 0; i < n - 1; i = i + 1) {
        int j;
        loop_invariant !arr.isEmpty;
        loop_invariant !arr.isEmpty;
        loop_invariant 0 <= \pointer_block_offset(arr.isEmpty ? null : get_int_pointer(arr.get)) + length;
        loop_invariant \pointer_block_offset(arr.isEmpty ? null : get_int_pointer(arr.get)) + length <=
        \pointer_block_length(arr.isEmpty ? null : get_int_pointer(arr.get));
        loop_invariant (\forall* int i1;
            0 <= i1 && i1 < length ==> Perm((arr.isEmpty ? null : get_int_pointer(arr.get)) + i1, write)
        );
        loop_invariant 0 <= j;
        loop_invariant j <= n - 1 - i;
        loop_invariant (\forall int k;
            n - i <= k && k < n - 1 ==> *(get_int_pointer(arr.get) + k + 0) <= *(get_int_pointer(arr.get) + k + 1 + 0)
        );
        loop_invariant (\forall int g, int h;
            0 <= g && g < n - i && n - i <= h && h < n ==>
                *(get_int_pointer(arr.get) + g + 0) <= *(get_int_pointer(arr.get) + h + 0)
        );
        loop_invariant (\forall int k;
            0 <= k && k < j ==> *(get_int_pointer(arr.get) + k + 0) <= *(get_int_pointer(arr.get) + j + 0)
        );
        for (j = 0; j < n - 1 - i; j = j + 1) {
            if (*(get_int_pointer(arr.get) + j + 0) > *(get_int_pointer(arr.get) + j + 1 + 0)) {
                int temp;
                temp = *(get_int_pointer(arr.get) + j + 0);
                *(get_int_pointer(arr.get) + j + 0) = *(get_int_pointer(arr.get) + j + 1 + 0);
                *(get_int_pointer(arr.get) + j + 1 + 0) = temp;
            }
        }
    }
}
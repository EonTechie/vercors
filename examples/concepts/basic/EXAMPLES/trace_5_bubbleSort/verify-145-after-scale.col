decreases;
ensures 2 <= \result;
pure int sizeof_int();

adt Pointer_1_array_int {
    pure int get_dim_0_int(Pointer_1_array_int array);
    pure NonNull<int> get_int_pointer(Pointer_1_array_int array);
    pure Pointer_1_array_int from_int_pointer(NonNull<int> ptr);
    axiom (\forall NonNull<int> i; get_int_pointer(from_int_pointer(i)) == i);
    axiom (\forall Pointer_1_array_int i;
        \pointer_block_length(get_int_pointer(i)) - \pointer_block_offset(get_int_pointer(i)) == get_dim_0_int(i)
    );
    axiom (\forall Pointer_1_array_int i; 0 < get_dim_0_int(i));
}

requires !arr.isEmpty;
requires 0 <= \pointer_block_offset(arr.isEmpty ? null : get_int_pointer(arr.get)) + length;
requires \pointer_block_offset(arr.isEmpty ? null : get_int_pointer(arr.get)) + length <=
\pointer_block_length(arr.isEmpty ? null : get_int_pointer(arr.get));
requires (\forall* int i; i \in {0 .. length} ==> Perm((arr.isEmpty ? null : get_int_pointer(arr.get)) + i, write));
requires 0 <= length;
ensures !arr.isEmpty;
ensures 0 <= \pointer_block_offset(arr.isEmpty ? null : get_int_pointer(arr.get)) + length;
ensures \pointer_block_offset(arr.isEmpty ? null : get_int_pointer(arr.get)) + length <=
\pointer_block_length(arr.isEmpty ? null : get_int_pointer(arr.get));
ensures (\forall* int i; i \in {0 .. length} ==> Perm((arr.isEmpty ? null : get_int_pointer(arr.get)) + i, write));
ensures (\forall int i;
    i \in {0 .. length - 2 + 1} ==> *(get_int_pointer(arr.get) + i) <= *(get_int_pointer(arr.get) + i + 1)
);
void bubbleSort(int tid, option<Pointer_1_array_int> arr, int length) {
    void return1;
    int n;
    n = length;
    int i;
    label LOOP;
    
    loop_invariant !arr.isEmpty;
    loop_invariant 0 <= \pointer_block_offset(arr.isEmpty ? null : get_int_pointer(arr.get)) + length;
    loop_invariant \pointer_block_offset(arr.isEmpty ? null : get_int_pointer(arr.get)) + length <=
    \pointer_block_length(arr.isEmpty ? null : get_int_pointer(arr.get));
    loop_invariant (\forall* int i1;
        i1 \in {0 .. length} ==> Perm((arr.isEmpty ? null : get_int_pointer(arr.get)) + i1, write)
    );
    loop_invariant i \in {0 .. n + 1};
    loop_invariant (\forall int k;
        k \in {n - i .. n - 1} ==> *(get_int_pointer(arr.get) + k) <= *(get_int_pointer(arr.get) + k + 1)
    );
    loop_invariant (\forall int g, int h;
        g \in {0 .. n - i} && n - i <= h && h < n ==> *(get_int_pointer(arr.get) + g) <= *(get_int_pointer(arr.get) + h)
    );
    for (i = 0; i < n - 1; i = i + 1) {
        int j;
        label LOOP1;
        
        loop_invariant !arr.isEmpty;
        loop_invariant 0 <= \pointer_block_offset(arr.isEmpty ? null : get_int_pointer(arr.get)) + length;
        loop_invariant \pointer_block_offset(arr.isEmpty ? null : get_int_pointer(arr.get)) + length <=
        \pointer_block_length(arr.isEmpty ? null : get_int_pointer(arr.get));
        loop_invariant (\forall* int i1;
            i1 \in {0 .. length} ==> Perm((arr.isEmpty ? null : get_int_pointer(arr.get)) + i1, write)
        );
        loop_invariant j \in {0 .. n - 1 - i + 1};
        loop_invariant (\forall int k;
            k \in {n - i .. n - 1} ==> *(get_int_pointer(arr.get) + k) <= *(get_int_pointer(arr.get) + k + 1)
        );
        loop_invariant (\forall int g, int h;
            g \in {0 .. n - i} && n - i <= h && h < n ==>
                *(get_int_pointer(arr.get) + g) <= *(get_int_pointer(arr.get) + h)
        );
        loop_invariant (\forall int k;
            k \in {0 .. j} ==> *(get_int_pointer(arr.get) + k) <= *(get_int_pointer(arr.get) + j)
        );
        for (j = 0; j < n - 1 - i; j = j + 1) {
            if (*(get_int_pointer(arr.get) + j + 1) < *(get_int_pointer(arr.get) + j)) {
                int temp;
                temp = *(get_int_pointer(arr.get) + j);
                *(get_int_pointer(arr.get) + j) = *(get_int_pointer(arr.get) + j + 1);
                *(get_int_pointer(arr.get) + j + 1) = temp;
            }
        }
    }
    label END;
    
    return return1;
}
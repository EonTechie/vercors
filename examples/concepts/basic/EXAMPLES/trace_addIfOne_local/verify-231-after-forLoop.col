ensures offset == 0 ==> \result == p;
ensures Pointer.pointerOffset(\result) == Pointer.pointerOffset(p) + offset;
ensures Pointer.pointerBlock(\result) == Pointer.pointerBlock(p);
pure Pointer ptrAdd(Pointer p, int offset);

decreases;
ensures \polarity_dependent(
    (\forall Pointer p, int offset, int i;
        0 <= Pointer.pointerOffset(p) + offset &&
        Pointer.pointerOffset(p) + offset < Block.blockLength(Pointer.pointerBlock(p)) &&
        0 <= Pointer.pointerOffset(p) + offset + i &&
        Pointer.pointerOffset(p) + offset + i < Block.blockLength(Pointer.pointerBlock(p)) ==>
            ptrAdd(ptrAdd(p, offset), i) == ptrAdd(p, offset + i)
    ),
    true
);
pure boolean ptrAddAxiom() = true;

decreases;
ensures (\forall Pointer p, int i, int j;
    0 <= Pointer.pointerOffset(p) + i && Pointer.pointerOffset(p) + i < Block.blockLength(Pointer.pointerBlock(p)) &&
    0 <= Pointer.pointerOffset(p) + j &&
    Pointer.pointerOffset(p) + j < Block.blockLength(Pointer.pointerBlock(p)) ==>
        i == j == ptrAdd(p, i) == ptrAdd(p, j)
);
pure boolean ptrAddAxiom2() = true;


ensures (\exists int x; 0 <= x && x < length && res == ptrDeref(ptrAdd(optGet1(arr), x)).Int);
void isBiggest1(int tid, Option<Pointer> arr, int length) returns (int res) {
    ref exc;
    exc = null;
    int return1;
    int biggest;
    int i;
    {
        int flatten;
        flatten = ptrDeref(ptrAdd(optGet1(arr), 0)).Int;
        biggest = flatten;
        flatten;
        label LOOP;
        
        ref excbeforeloop;
        excbeforeloop = exc;
        int flatten;
        flatten = 1;
        i = flatten;
        flatten;
        loop_invariant exc == excbeforeloop;
        loop_invariant arr != Option<Pointer>.`none`();
        loop_invariant 0 <= Pointer.pointerOffset(optGet1(arr)) + length;
        loop_invariant Pointer.pointerOffset(optGet1(arr)) + length <=
        Block.blockLength(Pointer.pointerBlock(optGet1(arr)));
        loop_invariant (\forall* int i1; 0 <= i1 && i1 < length ==> Value(ptrDeref(ptrAdd(optGet1(arr), i1)).Int));
        loop_invariant 1 <= i;
        loop_invariant i < length + 1;
        loop_invariant (\forall int x; 0 <= x && x < i ==> ptrDeref(ptrAdd(optGet1(arr), x)).Int <= biggest);
        loop_invariant (\exists int x; 0 <= x && x < i && biggest == ptrDeref(ptrAdd(optGet1(arr), x)).Int);
        while (i < length) {
            if (biggest < ptrDeref(ptrAdd(optGet1(arr), i)).Int) {
                int flatten;
                flatten = ptrDeref(ptrAdd(optGet1(arr), i)).Int;
                biggest = flatten;
                flatten;
            }
            int flatten;
            flatten = i;
            i = i + 1;
            flatten;
        }
        return1 = biggest;
        biggest;
        goto END;
    }
    label END;
    
    res = return1;
    return;
    label BUBBLE;
    
    assert exc == (null);
}


int isBiggest(int tid, pointer<int> arr, int length) {
    int return1;
    int biggest;
    int i;
    {
        biggest = arr[0];
        label LOOP;
        
        loop_invariant arr != null;
        loop_invariant 0 <= \pointer_block_offset(arr) + length;
        loop_invariant \pointer_block_offset(arr) + length <= \pointer_block_length(arr);
        loop_invariant (\forall* int i1; i1 \in {0 .. length} ==> Value(arr + i1));
        loop_invariant i \in {1 .. length + 1};
        loop_invariant (\forall int x; x \in {0 .. i} ==> arr[x] <= biggest);
        loop_invariant (\exists int x; x \in {0 .. i} && biggest == arr[x]);
        for (i = 1; i < length; i = i + 1) {
            if (biggest < arr[i]) {
                biggest = arr[i];
            }
        }
        return1 = biggest;
        goto END;
    }
    label END;
    
    return return1;
}
adt Option<t> {
    pure Option<t> `none`();
    pure Option<t> some(t x);
    pure t optionGet(Option<t> opt);
    axiom (\forall t x; `none`() != {: some(x) :});
    axiom (\forall t x; optionGet({: some(x) :}) == x);
    axiom (\forall Option<t> opt; {: some(optionGet(opt)) :} == opt);
}


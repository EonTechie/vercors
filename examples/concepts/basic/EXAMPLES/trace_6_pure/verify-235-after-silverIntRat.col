adt WellFoundedOrder<t> {
    pure boolean bounded(t v);
    pure boolean decreasing(t v1, t v2);
}

adt IntOrder {
    axiom (\forall int i; 0 <= i == WellFoundedOrder<int>.bounded(i));
    axiom (\forall int i; (\forall int j; i < j == WellFoundedOrder<int>.decreasing(i, j)));
}


adt Option<t> {
    pure Option<t> `none`();
    pure Option<t> some(t x);
    pure t optionGet(Option<t> opt);
    axiom (\forall t x; Option<t>.`none`() != Option<t>.some(x));
    axiom (\forall t x; Option<t>.optionGet(Option<t>.some(x)) == x);
    axiom (\forall Option<t> opt; Option<t>.some(Option<t>.optionGet(opt)) == opt);
}


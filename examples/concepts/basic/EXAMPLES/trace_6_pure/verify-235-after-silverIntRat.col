ensures res == prefixSum1(xs, length);
void sumList1(int tid, Option<Pointer> list, int length, seq<int> xs) returns (int res) {
    ref exc;
    exc = null;
    int return1;
    int sum;
    int i;
    int flatten;
    flatten = 0;
    sum = flatten;
    int flatten;
    flatten = 0;
    i = flatten;
    label LOOP;
    
    ref excbeforeloop;
    excbeforeloop = exc;
    decreases length - i;
    loop_invariant exc == excbeforeloop;
    loop_invariant list != Option<Pointer>.`none`();
    loop_invariant 0 <= Pointer.pointerOffset(optGet1(list)) + length;
    loop_invariant Pointer.pointerOffset(optGet1(list)) + length <=
    Block.blockLength(Pointer.pointerBlock(optGet1(list)));
    loop_invariant (\forall* int i1; 0 <= i1 && i1 < length ==> Value(ptrDeref(ptrAdd(optGet1(list), i1)).Int));
    loop_invariant |xs| == length;
    loop_invariant (\forall int x; 0 <= x && x < length ==> xs[x] == ptrDeref(ptrAdd(optGet1(list), x)).Int);
    loop_invariant 0 <= i;
    loop_invariant i < length + 1;
    loop_invariant sum == prefixSum1(xs, i);
    while (i < length) {
        int flatten;
        flatten = sum + ptrDeref(ptrAdd(optGet1(list), i)).Int;
        sum = flatten;
        int flatten;
        flatten = i;
        i = i + 1;
    }
    return1 = sum;
    goto END;
    label END;
    
    res = return1;
    return;
    label BUBBLE;
    
    assert exc == (null);
}


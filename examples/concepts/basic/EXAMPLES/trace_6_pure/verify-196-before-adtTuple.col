}

adt Pointer {
    pure Block pointerBlock(Pointer p);
    pure int pointerOffset(Pointer p);
    pure Pointer pointerInv(ref r);
    pure int ptrAddress(Pointer p, int stride);
    axiom (\forall Pointer p; {: pointerOffset(p) :} >= 0 && {: pointerOffset(p) :} < blockLength(pointerBlock(p)));
    axiom (\forall ref r; ptrDeref({: pointerInv(r) :}) == r);
    axiom (\forall Pointer p; pointerInv({: ptrDeref(p) :}) == p);
    axiom (\forall Pointer p, int stride;
        stride > 0 ==> {: ptrAddress(p, stride) :} == blockAddress(pointerBlock(p)) + pointerOffset(p) * stride
    );
    axiom (\forall Pointer p, int stride; stride > 0 ==> {: ptrAddress(p, stride) :} > 0);
    axiom (\forall Pointer p1, Pointer p2, int stride;
        stride > 0 &&
        {: ptrAddress(p1, stride) :} == {: ptrAddress(p2, stride) :} &&
        {: pointerBlock(p1) :} == {: pointerBlock(p2) :} ==>
            p1 == p2
    );
    axiom ptrAddAxiom();
    axiom ptrAddAxiom2();
    axiom (\forall Pointer i, int i1; ptrAddress(i, i1) <= 18446744073709551615);
}


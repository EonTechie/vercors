int sumList(int tid, pointer<int> list, int length, seq<int> xs) {
    int return1;
    int sum;
    int i;
    sum = 0;
    i = 0;
    label LOOP;
    
    decreases length - i;
    loop_invariant list != null;
    loop_invariant list != null;
    loop_invariant 0 <= \pointer_block_offset(list) + length;
    loop_invariant \pointer_block_offset(list) + length <= \pointer_block_length(list);
    loop_invariant (\forall* int i1; 0 <= i1 && i1 < length ==> Value(list + i1));
    loop_invariant |xs| == length;
    loop_invariant (\forall int x; 0 <= x && x < length ==> xs[x] == list[x]);
    loop_invariant 0 <= i;
    loop_invariant i <= length;
    loop_invariant sum == prefixSum(xs, i);
    for (;i < length; i = i + 1) {
        sum = sum + list[i];
    }
    return1 = sum;
    goto END;
    label END;
    
    return return1;
}
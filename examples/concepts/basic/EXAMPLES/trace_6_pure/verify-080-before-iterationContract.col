requires 0 <= n;
requires n <= |xs|;
decreases n;
pure int prefixSum(seq<int> xs, int n) = n == 0 ? 0 : prefixSum(xs, n - 1) + xs[n - 1];

decreases;
ensures \result >= 2;
pure int sizeof_int();

given seq<int> xs;
context_everywhere list != null;
context_everywhere list != null;
context_everywhere 0 <= \pointer_block_offset(list) + length;
context_everywhere \pointer_block_offset(list) + length <= \pointer_block_length(list);
context_everywhere (\forall* int i; 0 <= i && i < length ==> Value(list + i));
context_everywhere |xs| == length;
context_everywhere (\forall int x; 0 <= x && x < length ==> xs[x] == list[x]);
requires length >= 0;
ensures \result == prefixSum(xs, length);
int sumList(pointer<int> list, int length) {
    int sum;
    int i;
    sum = 0;
    i = 0;
    decreases length - i;
    loop_invariant 0 <= i;
    loop_invariant i <= length;
    loop_invariant sum == prefixSum(xs, i);
    for (;i < length; i = i + 1) {
        sum = sum + list[i];
    }
    return sum;
}
# One folder. All 19 .c files in it. No other directory.
# From the repository root:
#   ./util/robustness/run-benchmark.sh

MODE=preferred
TRANSFORM=add-if-zero
SITES=all

REPEAT=10
SEED=42

INPUT=examples/concepts/c
OUT=robustness-results/post-resolution/c
PROGRAMS=

VERIFY_ORIGINALS=1
VERIFY_MUTANTS=1
FORCE_ORIGINAL=0
STAMP=0
DRY_RUN=0

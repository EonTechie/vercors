 10 |       arr[i] <= arr[i + 1]);
 11 | @*/
 12 | void bubbleSort(int arr[], int length)
 13 | {
 14 |     int n = length;
 15 | 
 16 |     //@ loop_invariant 0 <= i && i <= n;
 17 |     //@ loop_invariant (\forall int k; n - i <= k && k < n - 1; arr[k] <= arr[k + 1]);
 18 |     //@ loop_invariant (\forall int g, int h; 0 <= g && g < n - i && n - i <= h && h < n; arr[g] <= arr[h]);
 19 | 
 20 |     for (int i = 0; i < n - 1; i++)
 21 |     {
 22 |         //@ loop_invariant 0 <= j && j <= n - 1 - i;
 23 |         //@ loop_invariant (\forall int k; n - i <= k && k < n - 1; arr[k] <= arr[k + 1]);
 24 |         //@ loop_invariant (\forall int g, int h; 0 <= g && g < n - i && n - i <= h && h < n; arr[g] <= arr[h]);
 25 |         //@ loop_invariant (\forall int k; 0 <= k && k < j; arr[k] <= arr[j]);
 26 | 
 27 |         for (int j = 0; j < n - 1 - i; j++)
 28 |         {
 29 |             if (arr[j] > arr[j + 1])
 30 |             {
 31 |                 int temp = arr[j];
 32 |                 arr[j] = arr[j + 1];
 33 |                 arr[j + 1] = temp;
 34 |             }
 35 |         }
 36 |     }
 37 | }

